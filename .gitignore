# =============================================================================
#  PhoneMonitor - файлы, не попадающие в репозиторий.
# =============================================================================

# --- Результаты сборки -------------------------------------------------------
build/
out/
bin/
obj/
*.obj
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib
*.cat

# --- CMake -------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json

# --- Visual Studio -----------------------------------------------------------
.vs/
*.user
*.suo
*.vcxproj.filters
*.VC.db
*.VC.opendb

# --- Драйвер: артефакты подписи ----------------------------------------------
# Сертификаты и закрытые ключи не должны попадать в репозиторий ни при
# каких обстоятельствах, даже тестовые.
*.cer
*.pfx
*.pvk
*.snk

# --- Android / Gradle --------------------------------------------------------
.gradle/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
*.jks

# --- Журналы и временные файлы -----------------------------------------------
*.log
streamer.log
*.tmp
Thumbs.db
desktop.ini
